# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# --- Node / React -----------------------------------------------------------
node_modules/
frontend/dist/
npm-debug.log*

# --- DeepCos artifacts (regenerated by the training scripts) ----------------
artifacts/models/*.keras
artifacts/models/*.h5
artifacts/logs/
artifacts/reports/
data/processed/
data/raw/*
!data/raw/.gitkeep
data/synthetic/

# --- Runtime -----------------------------------------------------------------
# Local environment files may contain secrets (MongoDB URI, GROQ_API_KEY, ...)
# and must never be committed.
.env
.env.*
!.env.example
*.log
.vscode/
.idea/
.DS_Store

# AI-learned knowledge-base overlay: generated at runtime from *unreviewed* AI
# enrichment. It is served locally, but it is not curated reference data, so it
# is not committed by default - use `git add -f <file>` if you want to ship it.
data/knowledge_base/learned_ingredients.json
