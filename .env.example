# ---------------------------------------------------------------------------
# DeepCos runtime configuration  (copy to .env and edit if needed)
# ---------------------------------------------------------------------------

# Backend
DEEPCOS_HOST=127.0.0.1
DEEPCOS_PORT=8000
DEEPCOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB. If the server is unreachable the backend automatically falls back to
# a local JSON document store, so the demo keeps working without MongoDB.
# For MongoDB Atlas use a connection-string placeholder and keep the real value
# in your local .env only (never commit credentials):
#   MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>/<db>?appName=<app>
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=deepcos

# OCR - full path to the native tesseract binary (leave empty if it is on PATH)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- AI ingredient enrichment (optional, off by default) ---------------------
# When enabled, ingredients that the local knowledge base cannot resolve are
# looked up through the Groq API and stored in a persistent enrichment cache
# (MongoDB collection `ingredient_enrichments`, JSON fallback otherwise).
# AI-derived data is displayed separately and labelled as informational; the
# verified reference files (ingredients.json / concern_rules.json) are never
# rewritten by it.
AI_ENRICHMENT_ENABLED=false
# Your Groq API key (https://console.groq.com). NEVER commit a real key here
# and never expose it to the frontend.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Optional override of the provider endpoint (defaults to the public Groq API)
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_SECONDS=20
AI_ENRICHMENT_MAX_ITEMS=10
AI_ENRICHMENT_CACHE_TTL_DAYS=30

# Knowledge-base promotion (default off). When enabled, a *validated* enrichment
# result for an ingredient the local knowledge base does not document is written
# to data/knowledge_base/learned_ingredients.json (the AI-learned overlay) and
# served on later runs, so no second AI call is needed. The verified reference
# files are never modified: every promoted entry stays labelled
# origin="ai-learned" / review_status="unreviewed" and can be deleted through
# DELETE /api/knowledge/learned.
AI_PROMOTE_TO_KB=false
# low | medium | high - minimum provider confidence needed before promoting.
AI_PROMOTE_MIN_CONFIDENCE=medium

# Frontend (Vite) - base URL of the FastAPI backend
VITE_API_BASE_URL=http://127.0.0.1:8000
